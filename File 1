function syncBattleTeamFromInventory(){
  const equipped=getEquippedEntries();

  if(equipped.length===0){
    return;
  }

  const fallback=[
    {name:"Bear",ability:"Heavy Strike",type:"Bruiser"},
    {name:"Wolf",ability:"Pack Hunter",type:"Hunter"},
    {name:"Fox",ability:"Trickster",type:"Trickster"}
  ];

  for(let i=0;i<3;i++){
    if(!equipped[i]){
      const f=fallback[i];
      team[i]={name:f.name,maxHp:60,hp:60,power:12,ability:f.ability,speed:12,type:f.type,inventoryId:null};
      continue;
    }

    const e=equipped[i];
    team[i]={
      name:e.name,
      maxHp:e.stats.hp,
      hp:e.stats.hp,
      power:e.stats.attack,
      ability:e.name==="Bear"?"Heavy Strike":
              e.name==="Wolf"?"Pack Hunter":
              e.name==="Fox"?"Trickster":
              e.name==="Rabbit"?"Quick Hop":
              e.name+" Signature",
      speed:e.stats.speed,
      type:e.name==="Bear"?"Bruiser":
           e.name==="Wolf"?"Hunter":
           e.name==="Fox"?"Trickster":
           e.name==="Rabbit"?"Swift":
           "Balanced",
      inventoryId:e.id
    };
  }
}
let activeTeamIndex=0;

function creatureByName(name){return creatures.find(c=>c.name===name)||creatures[0];}
function currentEnemyTemplate(){return biomeData[currentBiome][currentEnemyIndex];}

function freshEnemy(){
  syncBattleTeamFromInventory();
  const t=currentEnemyTemplate();
  enemy={...t,hp:t.hp,maxHp:t.hp};
  enemyDefeated=false;
  battleOver=false;
  $("nextEnemyBtn").disabled=true;
  $("battleStatus").textContent=`Defeat ${t.name} to continue the ${currentBiome} ladder.`;
  logBattle(`${t.name} enters the arena. Enemy ${currentEnemyIndex+1} of 10.`);
  renderBattle();
}

function resetBattleTeam(){
  syncBattleTeamFromInventory();
  team.forEach(t=>t.hp=t.maxHp);
  activeTeamIndex=0;
}

function renderEnemyLadder(){
  $("enemyLadder").innerHTML=biomeData[currentBiome].map((e,i)=>{
    const state=i<currentEnemyIndex?"cleared":i===currentEnemyIndex&&!enemyDefeated?"current":i===currentEnemyIndex&&enemyDefeated?"cleared":"";
    return `<div class="enemyNode ${state} ${e.type==="Boss"?"boss":""}" title="${e.name}">${i+1}</div>`;
  }).join("");
}

function renderBattle(){
  if(!enemy)return;
  syncBattleTeamFromInventory();
  const p=team[activeTeamIndex];
  $("battleBiomeTitle").textContent=currentBiome;
  $("enemyCounter").textContent=`Enemy ${currentEnemyIndex+1} / 10`;
  $("enemyImg").src=creatureByName(enemy.creature).img;
  $("enemyName").textContent=enemy.name;
  $("enemyType").textContent=`${enemy.type} · ${enemy.ability}`;
  $("playerImg").src=creatureByName(p.name).img;
  $("playerName").textContent=p.name;
  $("playerType").textContent=`${p.type} · ${p.ability}`;
  $("enemyHpText").textContent=`${Math.max(0,Math.floor(enemy.hp))} / ${enemy.maxHp} HP`;
  $("playerHpText").textContent=`${Math.max(0,Math.floor(p.hp))} / ${p.maxHp} HP`;
  $("enemyHpFill").style.width=Math.max(0,enemy.hp/enemy.maxHp*100)+"%";
  $("playerHpFill").style.width=Math.max(0,p.hp/p.maxHp*100)+"%";

  $("teamBar").innerHTML=team.map((t,i)=>`
    <div class="teamCard ${i===activeTeamIndex?"active":""}" data-i="${i}">
      <img src="${creatureByName(t.name).img}" alt="${t.name}">
      <div><b>${t.name}</b><small>${Math.max(0,t.hp)} / ${t.maxHp} HP</small></div>
    </div>`).join("");
  document.querySelectorAll(".teamCard").forEach(card=>{
    card.addEventListener("click",()=>switchCreature(Number(card.dataset.i)));
  });

  const disabled=battleOver||enemy.hp<=0||team[activeTeamIndex].hp<=0||enemyDefeated;
  $("attackBtn").disabled=disabled;
  $("abilityBtn").disabled=disabled;
  $("switchBtn").disabled=disabled;
  $("battlePotionBtn").disabled=disabled;
  $("nextEnemyBtn").disabled=!enemyDefeated;

  renderEnemyLadder();
}

function logBattle(t){$("battleLogLines").textContent=t;}

function enemyTurn(){
  if(battleOver||enemy.hp<=0||enemyDefeated)return;
  const p=team[activeTeamIndex];
  const speedDelta=(enemy.speed-p.speed);
  const dmg=Math.max(4,enemy.power+Math.floor(Math.random()*8)-Math.max(0,-speedDelta));
  p.hp=Math.max(0,p.hp-dmg);
  triggerBattleFx("slash","enemy");

  if(p.hp<=0){
    const next=team.findIndex(t=>t.hp>0);
    if(next>=0){
      activeTeamIndex=next;
      logBattle(`${p.name} is defeated. ${team[next].name} enters the battle.`);
    }else{
      battleOver=true;
      $("battleStatus").textContent="Defeat — your full team needs recovery.";
      logBattle("Your whole team has been defeated. Use a potion or restart the battle.");
    }
  }else{
    logBattle(`${enemy.name} attacks ${p.name} for ${dmg} damage.`);
  }
  renderBattle();
}

function winEnemy(){
  enemyDefeated=true;
  const rewardCoins=70+(currentEnemyIndex+1)*25;
  const rewardGems=currentEnemyIndex===9?5:1;
  coins+=rewardCoins;
  gems+=rewardGems;

  if(currentEnemyIndex===9){
    $("battleStatus").textContent=`Biome cleared! ${currentBiome} can now be revisited.`;
    logBattle(`${enemy.name} is defeated! +${rewardCoins} coins and +${rewardGems} gems. Final enemy complete.`);
  }else{
    $("battleStatus").textContent=`Enemy ${currentEnemyIndex+1} defeated. The next challenger is ready.`;
    logBattle(`${enemy.name} is defeated! +${rewardCoins} coins and +${rewardGems} gem${rewardGems===1?"":"s"}.`);
  }

  $("nextEnemyBtn").disabled=false;
  $("nextEnemyBtn").textContent=currentEnemyIndex===9?"↻ Restart Ladder":"➜ Next Enemy";
  update();
  renderBattle();
}

function playerMove(kind){
  if(battleOver||enemyDefeated)return;
  const p=team[activeTeamIndex];
  let dmg=Math.max(5,p.power+Math.floor(Math.random()*9));

  if(kind==="ability"){
    dmg=Math.floor(p.power*1.55)+Math.floor(Math.random()*10);
    if(p.name==="Wolf") dmg+=8;
    if(p.name==="Fox"){
      const heal=Math.min(p.maxHp-p.hp,8);
      p.hp+=heal;
    }
    if(p.name==="Bear") dmg+=6;
  }

  enemy.hp=Math.max(0,enemy.hp-dmg);

  const fxKind = kind==="ability"
    ? "ability"
    : p.name==="Fox"
      ? "fox"
      : p.name==="Bear"
        ? "bear"
        : "attack";
  triggerBattleFx(fxKind,"player");

  if(enemy.hp<=0){
    winEnemy();
    return;
  }

  logBattle(`${p.name} uses ${kind==="ability"?p.ability:"Attack"} for ${dmg} damage.`);
  renderBattle();
  setTimeout(enemyTurn,450);
}

$("attackBtn").addEventListener("click",()=>playerMove("attack"));
$("abilityBtn").addEventListener("click",()=>playerMove("ability"));

$("switchBtn").addEventListener("click",()=>{
  if(battleOver||enemyDefeated)return;
  const next=(activeTeamIndex+1)%team.length;
  switchCreature(next,true);
});

$("battlePotionBtn").addEventListener("click",()=>{
  if(battleOver||enemyDefeated)return;
  const p=team[activeTeamIndex];
  if(p.hp>=p.maxHp){say("HP is already full");return}
  if(fortune<=0){say("No potions available");return}
  fortune--;
  const heal=Math.min(p.maxHp-p.hp,35+Math.floor(Math.random()*16));
  p.hp+=heal;
  triggerBattleFx("ability","player");
  logBattle(`${p.name} restores ${heal} HP.`);
  renderBattle();
  setTimeout(enemyTurn,450);
});

$("nextEnemyBtn").addEventListener("click",()=>{
  if(!enemyDefeated)return;
  if(currentEnemyIndex===9){
    currentEnemyIndex=0;
    resetBattleTeam();
    say(`${currentBiome} ladder restarted`);
  }else{
    currentEnemyIndex++;
    resetBattleTeam();
  }
  freshEnemy();
});

function switchCreature(i,free=false){
  if(battleOver||enemyDefeated||i<0||i>=team.length||team[i].hp<=0)return;
  if(i===activeTeamIndex)return;
  activeTeamIndex=i;
  logBattle(`${team[i].name} enters the battle.`);
  renderBattle();
  if(!free)setTimeout(enemyTurn,450);
}

