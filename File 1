<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mythic RNG — Art Prototype V8</title>
<style>
:root{
  --bg:#050913; --panel:rgba(8,15,29,.84); --panel2:rgba(12,22,39,.90);
  --line:#27415e; --text:#f4f7ff; --muted:#91a3bb;
  --blue:#4db7ff; --purple:#987cff; --gold:#f2ba54; --pink:#e56cff;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:#050913;color:var(--text);font-family:Georgia,"Times New Roman",serif}
button{font:inherit;color:inherit;cursor:pointer}
body:before{
  content:"";position:fixed;inset:0;z-index:-2;
  background:linear-gradient(180deg,rgba(2,7,15,.45),rgba(2,6,14,.90)),url("data:image/jpeg;base64,") center/cover fixed no-repeat;
  filter:saturate(1.1) brightness(.58);
}
body:after{
  content:"";position:fixed;inset:0;z-index:-1;
  background:radial-gradient(circle at 50% 28%,rgba(74,109,190,.22),transparent 35%),
             radial-gradient(circle at 50% 70%,rgba(111,67,177,.12),transparent 45%);
  pointer-events:none;
}
.app{max-width:1480px;margin:auto;padding:16px}
.top{display:flex;align-items:center;gap:18px;justify-content:space-between}
.logo{font-weight:900;font-size:34px;letter-spacing:.06em;line-height:.82;color:#f4e3bc;text-shadow:0 0 18px #bb8cff55}
.logo span{display:block;font-size:25px;color:#8bd7ff}
.stats{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
.pill{min-width:150px;background:linear-gradient(180deg,#111f33dd,#091322dd);border:1px solid #38516b;border-radius:15px;padding:9px 14px;box-shadow:inset 0 1px 0 #ffffff16,0 12px 28px #0007}
.pill small{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.14em}
.pill b{font-size:18px}
.iconbtn{width:46px;height:46px;border-radius:50%;background:#101c2e;border:1px solid #38516b;font-size:21px}
.layout{display:grid;grid-template-columns:180px minmax(0,1fr) 275px;gap:13px;margin-top:14px}
.card{background:linear-gradient(180deg,#0d1726d9,#07111edb);border:1px solid #2a4563;border-radius:18px;box-shadow:0 22px 70px #0009,inset 0 1px #ffffff0b}
.sideNav{padding:10px}
.navbtn{width:100%;text-align:left;background:transparent;border:0;border-bottom:1px solid #23364d;padding:16px 12px;color:#cfd9e8;font-size:17px}
.navbtn.active{color:#fff;background:linear-gradient(90deg,#143655aa,transparent);box-shadow:inset 3px 0 #5ecbff}
.navbtn:hover{background:#ffffff07}
.main{padding:16px;min-height:820px}
.hero{display:flex;justify-content:space-between;align-items:end;gap:16px}
.zoneTitle{font-size:12px;text-transform:uppercase;letter-spacing:.22em;color:#87b9dc}
.h1{font-size:36px;font-weight:900;margin:3px 0}
.sub{color:#9eb0c5}
.zoneMini{border:1px solid #36556e;border-radius:14px;padding:10px 12px;min-width:180px;background:#091625c7}
.zoneMini small{color:var(--muted)}
.progress{height:8px;background:#07101b;border-radius:9px;overflow:hidden;margin-top:7px}
.bar{height:100%;background:linear-gradient(90deg,#f7be55,#60d3ff);width:28%}
.reelWrap{margin-top:18px;position:relative}
.reel{
  height:265px;border-radius:26px;overflow:hidden;border:1px solid #46647e;
  background:linear-gradient(180deg,#0a1120ee,#08111ce8);
  box-shadow:0 0 55px #6e63ff18,inset 0 0 70px #000;
  position:relative;
}
.reel:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#07111edd,transparent 13%,transparent 87%,#07111edd);z-index:2;pointer-events:none}
.reelTrack{height:100%;display:flex;align-items:stretch;gap:0;transform:translateX(0);will-change:transform}
.reelItem{flex:0 0 185px;position:relative;overflow:hidden;border-right:1px solid #314861}
.reelItem img{width:100%;height:100%;object-fit:cover;filter:saturate(1.1) brightness(.84)}
.reelItem:after{content:"";position:absolute;inset:auto 0 0;height:45%;background:linear-gradient(transparent,#06101c)}
.marker{position:absolute;left:50%;top:-9px;bottom:-9px;width:4px;transform:translateX(-50%);background:#fff7bf;box-shadow:0 0 18px #fff,0 0 34px #65caff;z-index:4}
.marker:before,.marker:after{content:"";position:absolute;left:50%;transform:translateX(-50%);width:0;height:0;border-left:11px solid transparent;border-right:11px solid transparent}
.marker:before{top:0;border-top:16px solid #fff0a0}
.marker:after{bottom:0;border-bottom:16px solid #fff0a0}
.reelBanner{position:absolute;left:50%;top:12px;transform:translateX(-50%);z-index:5;font-size:15px;letter-spacing:.25em;text-transform:uppercase;color:#d9efff;text-shadow:0 0 14px #54c6ff}
.revealCard{position:absolute;inset:20px;display:flex;align-items:center;justify-content:center;pointer-events:none;opacity:0;z-index:6}
.revealCard.show{opacity:1}
.revealCard .portrait{width:205px;height:205px;border-radius:20px;overflow:hidden;border:2px solid #ffffffa8;box-shadow:0 0 45px #ffffff33,0 0 100px var(--glow,#7c6dff66);animation:pop .72s cubic-bezier(.15,1.35,.28,1)}
.revealCard img{width:100%;height:100%;object-fit:cover}
@keyframes pop{0%{transform:scale(.45) rotate(-4deg);opacity:.2}60%{transform:scale(1.12)}100%{transform:scale(1)}}
.spinning .reelTrack{animation:drift .22s linear infinite}
@keyframes drift{to{transform:translateX(-370px)}}
.revealWrap{text-align:center;margin-top:9px;min-height:95px}
.rarity{font-size:13px;text-transform:uppercase;letter-spacing:.22em;color:#aac0d8}
.resultName{font-size:30px;font-weight:900;margin:4px}
.odds{color:#9cafc4}
.controls{display:flex;justify-content:center;align-items:center;gap:15px;margin-top:8px}
.rollBtn{width:180px;height:72px;border-radius:50%;border:2px solid #6ad7ff;background:radial-gradient(circle at 35% 30%,#63c9ff,#245aa5 45%,#0c2140 80%);box-shadow:0 0 30px #3bbcff66,0 12px 30px #0008;font-size:24px;font-weight:900}
.rollBtn:disabled{opacity:.48;cursor:not-allowed}
.toggleBtn{border:1px solid #3e5a73;background:#0d1a2c;border-radius:14px;padding:15px 18px}
.bottomGrid{display:grid;grid-template-columns:1.2fr 1.8fr;gap:13px;margin-top:15px}
.panel{padding:15px}
.panel h3{margin:0 0 10px;font-size:17px}
.quest{margin:9px 0}
.questTop{display:flex;justify-content:space-between;font-size:12px}
.questTop span:last-child{color:#b8d7f0}
.collection{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
.slot{aspect-ratio:1/1.18;border:1px solid #2d4660;border-radius:12px;background:#08111d;overflow:hidden;position:relative}
.slot img{width:100%;height:100%;object-fit:cover;filter:brightness(.82)}
.slot .cap{position:absolute;left:6px;right:6px;bottom:5px;font-size:10px;text-shadow:0 2px 5px #000}
.right{padding:11px}
.section{padding:12px 5px;border-bottom:1px solid #23384f}
.section:last-child{border-bottom:0}
.section h3{margin:0 4px 10px}
.drop{display:flex;align-items:center;gap:9px;padding:8px;border-radius:10px}
.drop img{width:42px;height:42px;border-radius:8px;object-fit:cover;border:1px solid #31516d}
.drop small{color:var(--muted);display:block}
.buy{width:100%;border:1px solid #34516d;background:#102037;border-radius:10px;padding:9px;margin-top:7px}
.buy:hover,.toggleBtn:hover{background:#16304e}
.lock{opacity:.55}
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,25px);opacity:0;pointer-events:none;padding:13px 17px;border-radius:12px;background:#eef6ff;color:#06101d;font-weight:900;z-index:30;transition:.25s;box-shadow:0 10px 35px #0009}
.toast.show{opacity:1;transform:translate(-50%,0)}
.screenFlash{position:fixed;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:20}
.screenFlash.on{animation:flash .55s ease}
@keyframes flash{0%{opacity:0}25%{opacity:.16}100%{opacity:0}}
@media(max-width:1100px){.layout{grid-template-columns:1fr 240px}.sideNav{display:none}.collection{grid-template-columns:repeat(3,1fr)}}
@media(max-width:780px){.top{flex-wrap:wrap}.layout{grid-template-columns:1fr}.right{order:3}.bottomGrid{grid-template-columns:1fr}.pill{min-width:120px}.reelItem{flex-basis:145px}}

/* V7: the actual rolled creature always lands beneath the center marker */
.reelItem[data-name] img{transition:filter .25s,transform .25s}
.reelItem.target img{filter:brightness(1.08) saturate(1.2)}


/* V8: smooth reel landing + persistent result */
.spinning .reelTrack{animation:none!important}
.reelTrack{will-change:transform}
.rollTarget{outline:2px solid #fff7bc;outline-offset:-2px;box-shadow:inset 0 0 35px #ffffff12,0 0 30px #fff3}
.battleScreen{padding:18px;min-height:820px}
.battleHeader{display:flex;justify-content:space-between;gap:18px;align-items:flex-end}
.battleReward{padding:12px 16px;border:1px solid #3d5c78;border-radius:13px;background:#0b1829}
.battleReward small{color:#8fa5bd}
.battleArena{margin-top:20px;min-height:400px;padding:25px;display:grid;grid-template-columns:1fr 120px 1fr;align-items:center;gap:20px;border:1px solid #3d5b76;border-radius:25px;background:radial-gradient(circle at 50% 46%,#172a4b55,transparent 38%),linear-gradient(180deg,#07101be8,#091728f2);box-shadow:inset 0 0 90px #000b,0 25px 65px #0009}
.fighter{text-align:center;position:relative}
.fighterTag{font-size:10px;letter-spacing:.18em;color:#7e9bb5;text-transform:uppercase;margin-bottom:10px}
.fighterPortrait{width:235px;height:235px;margin:auto;border-radius:24px;overflow:hidden;border:2px solid #43637f;box-shadow:0 0 40px #2e96ff22}
.enemy .fighterPortrait{transform:scaleX(-1);border-color:#8c5260}
.fighterPortrait img{width:100%;height:100%;object-fit:cover}
.fighterName{font-size:28px;font-weight:900;margin-top:11px}
.hpTrack{width:90%;height:14px;background:#050b13;border:1px solid #29435b;border-radius:10px;margin:12px auto 5px;overflow:hidden}
.hpFill{height:100%;width:100%;transition:width .35s ease}
.enemyHpFill{background:linear-gradient(90deg,#ff6060,#ff9a55)}
.playerHpFill{background:linear-gradient(90deg,#4ce7a5,#55baff)}
.hpText{font-size:12px;color:#a9bdd1}
.vs{font-size:42px;font-weight:900;letter-spacing:.12em;text-align:center;color:#e6edf8;text-shadow:0 0 20px #71c4ff66}
.battleLog{margin-top:15px;padding:12px 15px;color:#b9c9da;min-height:60px}
#battleLogLines{margin-top:6px;font-size:13px}
.battleActions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:15px}
.battleAction{min-width:145px;padding:13px 18px;border:1px solid #375670;border-radius:12px;background:linear-gradient(180deg,#12243b,#0c1829)}
.battleAction:hover{background:#173252}
.battleAction.primary{border-color:#59caff;background:linear-gradient(180deg,#20649a,#123a61);box-shadow:0 0 24px #3dbaff33}
.battleAction:disabled{opacity:.45;cursor:not-allowed}
.teamBar{display:flex;justify-content:center;gap:10px;margin-top:16px;flex-wrap:wrap}
.teamCard{width:155px;padding:8px;border:1px solid #2f4962;border-radius:12px;background:#091421;display:flex;gap:8px;align-items:center;cursor:pointer}
.teamCard.active{border-color:#63cfff;box-shadow:0 0 18px #43c8ff22}
.teamCard img{width:48px;height:48px;border-radius:8px;object-fit:cover}
.teamCard small{display:block;color:#8fa6bd}
@media(max-width:850px){
  .battleArena{grid-template-columns:1fr;min-height:0}
  .vs{font-size:30px}
  .fighterPortrait{width:180px;height:180px}
}


/* V9 battle ladder + enemy identities */
.enemyLadder{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-top:14px}
.enemyNode{height:34px;border:1px solid #2d4760;background:#091523;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:11px;color:#7991a8}
.enemyNode.current{border-color:#62ccff;color:#dff7ff;box-shadow:0 0 14px #46c6ff33}
.enemyNode.cleared{background:linear-gradient(180deg,#173d45,#0a1d22);color:#71e0b5;border-color:#3d846f}
.enemyNode.boss{border-color:#8065bf}
.fighterType{font-size:11px;color:#8fa8c0;text-transform:uppercase;letter-spacing:.08em;margin-top:2px}
.battleAction.special{border-color:#765ab5;background:linear-gradient(180deg,#3b2a66,#23193d)}
.battleAction.special:disabled{opacity:.35}
@media(max-width:850px){.enemyLadder{grid-template-columns:repeat(5,1fr)}}


/* V10 battle attack graphics — CSS-only so the prototype stays self-contained */
.battleFx{
  position:absolute;
  inset:0;
  pointer-events:none;
  overflow:hidden;
  z-index:8;
}
.battleArena{position:relative;overflow:hidden}
.fxSlash,.fxBurst,.fxWave,.fxSpark{
  position:absolute;
  left:50%;
  top:50%;
  width:150px;
  height:150px;
  transform:translate(-50%,-50%);
  pointer-events:none;
}
.fxSlash:before,.fxSlash:after{
  content:"";
  position:absolute;
  left:50%;
  top:50%;
  width:155px;
  height:10px;
  border-radius:999px;
  background:linear-gradient(90deg,transparent,#fff,#7ddcff,transparent);
  box-shadow:0 0 18px #5edaff;
  transform:translate(-50%,-50%) rotate(-28deg);
}
.fxSlash:after{transform:translate(-50%,-50%) rotate(28deg)}
.fxSlash{animation:slashFX .48s ease-out forwards}
@keyframes slashFX{
  0%{opacity:0;transform:translate(-50%,-50%) scale(.2) rotate(-20deg)}
  18%{opacity:1}
  100%{opacity:0;transform:translate(-50%,-50%) scale(1.45) rotate(10deg)}
}
.fxBurst{
  border-radius:50%;
  border:3px solid #ffd66b;
  box-shadow:0 0 25px #ffad40, inset 0 0 25px #ff5e5e;
  animation:burstFX .6s ease-out forwards;
}
@keyframes burstFX{
  0%{opacity:1;transform:translate(-50%,-50%) scale(.2)}
  70%{opacity:.9}
  100%{opacity:0;transform:translate(-50%,-50%) scale(1.6)}
}
.fxWave{
  border-radius:50%;
  border:5px solid #74e5ff;
  box-shadow:0 0 30px #5ac6ff;
  animation:waveFX .7s cubic-bezier(.16,.8,.2,1) forwards;
}
@keyframes waveFX{
  0%{opacity:.9;transform:translate(-50%,-50%) scale(.25)}
  100%{opacity:0;transform:translate(-50%,-50%) scale(2.1)}
}
.fxSpark:before,.fxSpark:after{
  content:"✦";
  position:absolute;
  left:50%;
  top:50%;
  color:#fff5ab;
  text-shadow:0 0 18px #fff,0 0 30px #8ddfff;
  font-size:54px;
  transform:translate(-50%,-50%);
}
.fxSpark:after{font-size:26px;transform:translate(55px,-60px)}
.fxSpark{animation:sparkFX .75s ease-out forwards}
@keyframes sparkFX{
  0%{opacity:0;transform:translate(-50%,-50%) scale(.3)}
  18%{opacity:1}
  100%{opacity:0;transform:translate(-50%,-50%) scale(1.5) rotate(22deg)}
}
.fighter.attackBounce{animation:attackBounce .36s ease}
.fighter.hitShake{animation:hitShake .34s ease}
@keyframes attackBounce{
  0%,100%{transform:translateX(0)}
  45%{transform:translateX(18px) scale(1.02)}
}
@keyframes hitShake{
  0%,100%{transform:translateX(0)}
  20%{transform:translateX(-8px)}
  40%{transform:translateX(8px)}
  60%{transform:translateX(-5px)}
  80%{transform:translateX(4px)}
}


/* V11 Inventory */
.inventoryScreen{
  padding:18px;
  min-height:820px;
}
.inventoryGrid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(210px,1fr));
  gap:14px;
  margin-top:18px;
}
.inventoryCard{
  position:relative;
  overflow:hidden;
  border:1px solid #2d4863;
  border-radius:16px;
  background:linear-gradient(180deg,#0d1a2adf,#08111ddb);
  box-shadow:0 16px 35px #0007,inset 0 1px #ffffff0a;
  transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;
}
.inventoryCard:hover{
  transform:translateY(-3px);
  border-color:#58caff;
  box-shadow:0 20px 42px #0009,0 0 24px #43c8ff19;
}
.inventoryPortrait{
  width:100%;
  height:150px;
  overflow:hidden;
  background:#07101b;
}
.inventoryPortrait img{
  width:100%;
  height:100%;
  object-fit:cover;
  filter:saturate(1.08) brightness(.88);
}
.inventoryBody{padding:12px}
.inventoryName{font-size:20px;font-weight:900}
.inventoryRarity{
  margin-top:2px;
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.16em;
  color:#8fa8c0;
}
.inventoryLevel{
  margin-top:8px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:12px;
}
.inventoryLevel b{color:#e8f5ff}
.inventoryExp{
  margin-top:7px;
  height:6px;
  border-radius:8px;
  overflow:hidden;
  background:#050b12;
}
.inventoryExpFill{
  width:0%;
  height:100%;
  background:linear-gradient(90deg,#5fcfff,#9a83ff);
}
.inventoryStats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:6px;
  margin-top:10px;
}
.inventoryStat{
  padding:7px;
  border:1px solid #233b52;
  border-radius:9px;
  background:#091523;
}
.inventoryStat small{
  display:block;
  color:#8098b0;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.08em;
}
.inventoryStat b{font-size:13px}
.inventoryEmpty{
  grid-column:1/-1;
  padding:50px 20px;
  text-align:center;
  border:1px dashed #35506a;
  border-radius:16px;
  color:#8298ad;
}
@media(max-width:700px){
  .inventoryGrid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:480px){
  .inventoryGrid{grid-template-columns:1fr}
}


.collectionScreen{padding:18px;min-height:820px}
.collectionGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;margin-top:18px}
.collectionCard{overflow:hidden;border:1px solid #2d4863;border-radius:16px;background:linear-gradient(180deg,#0d1a2adf,#08111ddb);box-shadow:0 16px 35px #0007,inset 0 1px #ffffff0a}
.collectionCard.equipped{border-color:#61d1ff;box-shadow:0 0 24px #43c8ff1f,0 16px 35px #0007}
.collectionCard img{width:100%;height:145px;display:block;object-fit:cover}
.collectionBody{padding:12px}
.collectionName{font-size:20px;font-weight:900}
.collectionMeta{font-size:10px;color:#8fa8c0;text-transform:uppercase;letter-spacing:.14em}
.collectionStats{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px}
.collectionStat{padding:7px;border:1px solid #233b52;border-radius:9px;background:#091523}
.collectionStat small{display:block;color:#8098b0;font-size:9px;text-transform:uppercase}
.collectionStat b{font-size:13px}
.collectionAction{width:100%;margin-top:10px;padding:10px 12px;border:1px solid #375b74;border-radius:10px;background:#0e2135}
.collectionAction:hover{background:#173654}
.collectionAction.remove{border-color:#7c5360;background:#24131b}
.equippedTeam{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}
.equippedSlot{padding:10px;min-height:90px;border:1px dashed #365471;border-radius:12px;background:#091522;display:flex;align-items:center;gap:10px}
.equippedSlot img{width:62px;height:62px;object-fit:cover;border-radius:10px}
.equippedSlot small{display:block;color:#8ea5bd}
.collectionEmpty{grid-column:1/-1;padding:50px 20px;text-align:center;border:1px dashed #35506a;border-radius:16px;color:#8298ad}
@media(max-width:760px){.equippedTeam{grid-template-columns:1fr}}


.rareCutscene{
  position:fixed;inset:0;z-index:40;display:none;
  align-items:center;justify-content:center;flex-direction:column;
  text-align:center;
  background:radial-gradient(circle at 50% 48%,#1b2f59ee 0,#040711fa 58%,#00030afc 100%);
  backdrop-filter:blur(5px);
}
.rareCutscene.show{display:flex;animation:sceneIn .35s ease both}
.cutsceneGlow{
  position:absolute;width:44vw;height:44vw;min-width:300px;min-height:300px;
  border-radius:50%;
  background:radial-gradient(circle,#6fd5ff44,transparent 65%);
  animation:glowPulse 1.35s ease-in-out infinite alternate;
}
.cutsceneLine{position:relative;color:#dbeeff;font-size:14px;text-transform:uppercase;letter-spacing:.28em;margin-bottom:13px}
.cutsceneName{
  position:relative;font-size:clamp(38px,6vw,78px);font-weight:900;
  text-shadow:0 0 22px #fff4,0 0 55px #65caff;
  animation:nameReveal .7s cubic-bezier(.15,1.35,.25,1) both;
}
.cutsceneFlavor{position:relative;max-width:650px;margin:14px 20px 0;color:#a9bad0;font-size:16px;line-height:1.55;animation:fadeUp .8s .1s ease both}
.cutsceneSkip{position:absolute;right:24px;top:20px;padding:8px 13px;border:1px solid #4f6880;border-radius:9px;background:#0d1828;color:#a9bfd4}
@keyframes sceneIn{from{opacity:0}to{opacity:1}}
@keyframes glowPulse{from{transform:scale(.9);opacity:.65}to{transform:scale(1.08);opacity:1}}
@keyframes nameReveal{from{transform:scale(.55);opacity:0;filter:blur(8px)}to{transform:scale(1);opacity:1;filter:blur(0)}}
@keyframes fadeUp{from{transform:translateY(14px);opacity:0}to{transform:translateY(0);opacity:1}}

</style>
</head>
<body>
<div class="screenFlash" id="flash"></div>
