function showAdmin(){
  const text=[
    "ADMIN CONSOLE",
    "",
    "/coins 5000",
    "/gems 500",
    "/luck 10",
    "/fortune 25",
    "/roll 50",
    "/reveal",
    "/clear",
    "/enemy 1-10",
    "/biome forest|frozen|volcanic|sky|void",
    "/win",
    "/heal",
    "/enemyheal",
    "/restartbattle",
    "/reset"
  ].join("\n");

  const cmd=prompt(text+"\n\nEnter a command:");
  if(!cmd)return;
  const parts=cmd.trim().toLowerCase().split(/\s+/);

  if(parts[0]==="/coins")coins=Number(parts[1])||5000;
  else if(parts[0]==="/gems")gems=Number(parts[1])||500;
  else if(parts[0]==="/luck")luck=Number(parts[1])||10;
  else if(parts[0]==="/lucktest"){
    const n=Math.max(1,Math.min(100000,Number(parts[1])||100));
    const oldLuck=luck;
    let counts={Common:0,Uncommon:0,Rare:0,Epic:0,Legendary:0,Mythic:0,Eldritch:0};
    luck=n;
    for(let i=0;i<1000;i++)counts[weightedPick().rarity]++;
    luck=oldLuck;
    alert(`Luck test at ${n}× (1000 rolls):\n\n`+
      Object.entries(counts).map(([r,c])=>`${r}: ${c}`).join("\n"));
  }

  else if(parts[0]==="/fortune")fortune=Number(parts[1])||25;
  else if(parts[0]==="/roll")rolls+=Number(parts[1])||50;
  else if(parts[0]==="/reveal"){owned=new Set(creatures.map(c=>c.name));say("All creatures revealed");}
  else if(parts[0]==="/clear"){owned.clear();say("Collection cleared");}
  else if(parts[0]==="/enemy"){
    const n=Number(parts[1]); if(n>=1&&n<=10)adminJumpEnemy(n);
  }
  else if(parts[0]==="/biome"){
    const map={forest:"Enchanted Forest",frozen:"Frozen Wastes",volcanic:"Volcanic Realm",sky:"Sky Islands",void:"Void Realm"};
    if(map[parts[1]])adminSetBiome(map[parts[1]]);
  }
  else if(parts[0]==="/win"){
    if(enemy){enemy.hp=0;winEnemy()}
  }
  else if(parts[0]==="/heal"){
    team.forEach(t=>t.hp=t.maxHp);renderBattle();say("Team fully healed");
  }
  else if(parts[0]==="/enemyheal"){
    if(enemy){enemy.hp=enemy.maxHp;renderBattle();say("Enemy fully healed")}
  }
  else if(parts[0]==="/restartbattle")adminNewBattle();
  else if(parts[0]==="/reset"){location.reload();return;}
  update();
  renderBattle();
}

