<div class="toast" id="toast"></div>

<script>
const creatures = [
  {name:"Rabbit", rarity:"Common", odds:2, img:"data:image/jpeg;base64,", flavor:"A quick little wanderer of the forest."},
  {name:"Deer", rarity:"Common", odds:5, img:"data:image/jpeg;base64,", flavor:"Quiet, alert, and strangely lucky."},
  {name:"Fox", rarity:"Uncommon", odds:7, img:"data:image/jpeg;base64,", flavor:"A clever hunter that rarely fights fair."},
  {name:"Wolf", rarity:"Rare", odds:13, img:"data:image/jpeg;base64,", flavor:"A disciplined hunter with a relentless stride."},
  {name:"Bear", rarity:"Rare", odds:25, img:"data:image/jpeg;base64,", flavor:"A powerful guardian of the old woods."},
  {name:"Golden Stag", rarity:"Epic", odds:67, img:"data:image/jpeg;base64,", flavor:"An antlered spirit touched by golden light."},
  {name:"Moon Wolf", rarity:"Legendary", odds:286, img:"data:image/jpeg;base64,", flavor:"Its howl is said to bend the night sky."},
  {name:"Star Dragon", rarity:"Mythic", odds:833, img:"data:image/jpeg;base64,", flavor:"A celestial dragon born from the stars."},
  {name:"Phoenix", rarity:"Mythic", odds:1400, img:"data:image/jpeg;base64,", flavor:"A creature of flame that refuses to stay gone."},
  {name:"Celestial Phoenix", rarity:"Eldritch", odds:6500, img:"data:image/jpeg;base64,", flavor:"A radiant thing that burns without consuming itself."},
  {name:"Void Serpent", rarity:"Eldritch", odds:10000, img:"data:image/jpeg;base64,", flavor:"Something that coils through places where space should be."},
  {name:"Frost Wyrm", rarity:"Eldritch", odds:16000, img:"data:image/jpeg;base64,", flavor:"A pale wyrm from a world of endless winter."},
  {name:"The Last Observer", rarity:"Eldritch", odds:50000, img:"data:image/jpeg;base64,", flavor:"It does not hunt. It simply watches."},
  {name:"The Nameless Star", rarity:"Eldritch", odds:100000, img:"data:image/jpeg;base64,", flavor:"A light from beyond the edge of the known sky."}
];
const rarityWeight = {Common:120,Uncommon:35,Rare:13,Epic:5,Legendary:2,Mythic:0.7,Eldritch:0.08};
let coins=1250,gems=42,luck=1,fortune=3,rolling=false,auto=false,rolls=12,epics=0,owned=new Set(["Rabbit","Deer","Fox"]);
let recent=["Fox","Bear","Rabbit"];
let inventory = [];

let equippedInventoryIds=[];

function inventoryEntryById(id){
  return inventory.find(x=>x.id===id)||null;
}

function getEquippedEntries(){
  return equippedInventoryIds.map(inventoryEntryById).filter(Boolean).slice(0,3);
}

function renderEquippedTeam(){
  const box=$("equippedTeam");
  const count=$("equippedCount");
  if(!box||!count)return;
  const entries=getEquippedEntries();
  count.textContent=entries.length;

  const slots=[];
  for(let i=0;i<3;i++){
    const e=entries[i];
    if(!e){
      slots.push(`<div class="equippedSlot"><div style="font-size:30px;opacity:.45">＋</div><div><b>Empty Slot</b><small>Equip from Collection</small></div></div>`);
    }else{
      const c=creatures.find(x=>x.name===e.name);
      slots.push(`<div class="equippedSlot"><img src="${c?c.img:""}" alt="${e.name}"><div><b>${e.name}</b><small>Level ${e.level} · ${e.rarity}</small></div></div>`);
    }
  }
  box.innerHTML=slots.join("");
}

function equipInventoryCreature(id){
  if(equippedInventoryIds.includes(id)){say("That creature is already equipped.");return;}
  if(equippedInventoryIds.length>=3){say("Your battle team is full (3 / 3).");return;}
  equippedInventoryIds.push(id);
  renderCollectionScreen();
  renderEquippedTeam();
  say("Creature equipped for battle.");
}

function unequipInventoryCreature(id){
  equippedInventoryIds=equippedInventoryIds.filter(x=>x!==id);
  renderCollectionScreen();
  renderEquippedTeam();
  say("Creature removed from battle team.");
}

function renderCollectionScreen(){
  const grid=$("collectionGrid");
  if(!grid)return;

  if(inventory.length===0){
    grid.innerHTML=`<div class="collectionEmpty">Your Collection is empty.<br><span>Summon a creature first.</span></div>`;
    renderEquippedTeam();
    return;
  }

  grid.innerHTML=inventory.map(entry=>{
    const c=creatures.find(x=>x.name===entry.name);
    if(!c)return "";
    const equipped=equippedInventoryIds.includes(entry.id);

    return `
      <article class="collectionCard ${equipped?"equipped":""}">
        <img src="${c.img}" alt="${entry.name}">
        <div class="collectionBody">
          <div class="collectionName">${entry.name}</div>
          <div class="collectionMeta">${entry.rarity} · Level ${entry.level} · EXP ${entry.exp}/100</div>
          <div class="collectionStats">
            <div class="collectionStat"><small>HP</small><b>${entry.stats.hp}</b></div>
            <div class="collectionStat"><small>Attack</small><b>${entry.stats.attack}</b></div>
            <div class="collectionStat"><small>Defense</small><b>${entry.stats.defense}</b></div>
            <div class="collectionStat"><small>Speed</small><b>${entry.stats.speed}</b></div>
          </div>
          <button class="collectionAction ${equipped?"remove":""}" data-equip-id="${entry.id}">
            ${equipped?"✕ Unequip":"⚔ Equip for Battle"}
          </button>
        </div>
      </article>`;
  }).join("");

  document.querySelectorAll("[data-equip-id]").forEach(btn=>{
    btn.onclick=()=>{
      const id=btn.dataset.equipId;
      if(equippedInventoryIds.includes(id))unequipInventoryCreature(id);
      else equipInventoryCreature(id);
    };
  });

  renderEquippedTeam();
}


const $ = id => document.getElementById(id);
const reelTrack=$("reelTrack");

function weightedPick(){
  const L=Math.max(1,Number(luck)||1);
  const rarityBoost={
    Common:0.00,
    Uncommon:0.10,
    Rare:0.34,
    Epic:0.65,
    Legendary:0.95,
    Mythic:1.25,
    Eldritch:1.60
  };

  const weights=creatures.map(c=>{
    const base=1/Math.max(1,c.odds);
    return base*Math.pow(L,rarityBoost[c.rarity]||0);
  });

  const total=weights.reduce((a,b)=>a+b,0);
  let r=Math.random()*total;
  for(let i=0;i<creatures.length;i++){
    r-=weights[i];
    if(r<=0)return creatures[i];
  }
  return creatures[0];
}
function rarityTier(r){return {Common:0,Uncommon:0,Rare:1,Epic:2,Legendary:3,Mythic:4,Eldritch:5}[r]||0}

function getInventoryStats(creature){
  const rarityBases = {
    Common:{hp:40,attack:8,defense:7,speed:14},
    Uncommon:{hp:52,attack:11,defense:9,speed:15},
    Rare:{hp:68,attack:15,defense:12,speed:16},
    Epic:{hp:88,attack:20,defense:16,speed:17},
    Legendary:{hp:115,attack:27,defense:21,speed:18},
    Mythic:{hp:150,attack:36,defense:27,speed:20},
    Eldritch:{hp:210,attack:50,defense:38,speed:22}
  };

  const speciesMods = {
    Rabbit:{hp:-5,attack:-1,defense:-2,speed:7},
    Deer:{hp:8,attack:1,defense:1,speed:3},
    Fox:{hp:-2,attack:3,defense:-1,speed:6},
    Wolf:{hp:6,attack:5,defense:2,speed:4},
    Bear:{hp:28,attack:7,defense:8,speed:-5},
    Dragon:{hp:45,attack:12,defense:9,speed:2}
  };

  const base=rarityBases[creature.rarity]||rarityBases.Common;
  const mod=speciesMods[creature.name]||speciesMods.Fox;

  return {
    hp:Math.max(1,base.hp+mod.hp),
    attack:Math.max(1,base.attack+mod.attack),
    defense:Math.max(1,base.defense+mod.defense),
    speed:Math.max(1,base.speed+mod.speed)
  };
}

function addToInventory(creature){
  const entry={
    id:Date.now()+"_"+Math.random().toString(36).slice(2,9),
    name:creature.name,
    rarity:creature.rarity,
    stats:getInventoryStats(creature),
    level:1,
    exp:0
  };

  inventory.push(entry);
  renderInventory();
  renderCollectionScreen();
  return entry;
}

function renderInventory(){
  const grid=$("inventoryGrid");
  const count=$("inventoryCount");
  if(!grid||!count)return;

  count.textContent=inventory.length;

  if(inventory.length===0){
    grid.innerHTML=`
      <div class="inventoryEmpty">
        No creatures yet.<br>
        <span>Roll to summon your first companion.</span>
      </div>`;
    return;
  }

  grid.innerHTML=inventory.map(entry=>{
    const creature=creatures.find(c=>c.name===entry.name);
    if(!creature)return "";

    const expPercent=Math.min(100,(entry.exp/100)*100);

    return `
      <article class="inventoryCard">
        <div class="inventoryPortrait">
          <img src="${creature.img}" alt="${entry.name}">
        </div>
        <div class="inventoryBody">
          <div class="inventoryName">${entry.name}</div>
          <div class="inventoryRarity">${entry.rarity}</div>
          <div class="inventoryLevel">
            <b>Level ${entry.level}</b>
            <span>EXP ${entry.exp} / 100</span>
          </div>
          <div class="inventoryExp">
            <div class="inventoryExpFill" style="width:${expPercent}%"></div>
          </div>
          <div class="inventoryStats">
            <div class="inventoryStat"><small>HP</small><b>${entry.stats.hp}</b></div>
            <div class="inventoryStat"><small>Attack</small><b>${entry.stats.attack}</b></div>
            <div class="inventoryStat"><small>Defense</small><b>${entry.stats.defense}</b></div>
            <div class="inventoryStat"><small>Speed</small><b>${entry.stats.speed}</b></div>
          </div>
        </div>
      </article>`;
  }).join("");
}

function say(t){$("toast").textContent=t;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),1800)}
function update(){
  $("coins").textContent=coins.toLocaleString(); $("gems").textContent=gems;
  $("luck").textContent=luck.toFixed(2)+"×"; $("potion").textContent=fortune;
  $("found").textContent=owned.size;
  $("zoneBar").style.width=Math.min(100,owned.size/10*100)+"%";
  $("qRoll").textContent=rolls+" / 50"; $("qRollBar").style.width=Math.min(100,rolls/50*100)+"%";
  $("qDisc").textContent=owned.size+" / 5"; $("qDiscBar").style.width=Math.min(100,owned.size/5*100)+"%";
  $("qEpic").textContent=epics+" / 1"; $("qEpicBar").style.width=Math.min(100,epics*100)+"%";
  renderCollection(); renderRecent();
}
function renderCollection(){
  $("collection").innerHTML="";
  creatures.slice(0,8).forEach(c=>{
    const d=document.createElement("div"); d.className="slot"+(owned.has(c.name)?"":" lock");
    d.innerHTML=`<img src="${c.img}" alt=""><div class="cap">${owned.has(c.name)?c.name:"???"}</div>`;
    $("collection").appendChild(d);
  })
}
function renderRecent(){
  $("recent").innerHTML=recent.map(n=>{
    const c=creatures.find(x=>x.name===n);
    return `<div class="drop"><img src="${c.img}"><div><b>${c.name}</b><small>${c.rarity}</small></div></div>`
  }).join("");
}
function buildReel(target=null){
  reelTrack.innerHTML="";
  reelTrack.style.transition="none";
  reelTrack.style.transform="translateX(0)";

  const sequence=[];
  for(let i=0;i<34;i++){
    sequence.push(creatures[Math.floor(Math.random()*creatures.length)]);
  }

  const targetIndex=28;
  if(target)sequence[targetIndex]=target;

  sequence.forEach(c=>{
    const item=document.createElement("div");
    item.className="reelItem";
    item.dataset.name=c.name;
    item.innerHTML=`<img src="${c.img}" alt="${c.name}">`;
    reelTrack.appendChild(item);
  });

  return targetIndex;
}

function centerReelOn(index, animate=true){
  const item=reelTrack.children[index];
  if(!item) return;
  const reelBox=document.getElementById("reel").getBoundingClientRect();
  const itemBox=item.getBoundingClientRect();
  const currentCenter=itemBox.left + itemBox.width/2;
  const desiredCenter=reelBox.left + reelBox.width/2;
  const delta=desiredCenter-currentCenter;

  reelTrack.style.transition=animate ? "transform 1.15s cubic-bezier(.12,.82,.18,1)" : "none";
  const currentMatrix=getComputedStyle(reelTrack).transform;
  let currentX=0;
  if(currentMatrix && currentMatrix!=="none"){
    const match=currentMatrix.match(/^matrix\(([^)]+)\)$/);
    if(match){
      const parts=match[1].split(",");
      currentX=parseFloat(parts[4]) || 0;
    }
  }
  reelTrack.style.transform=`translateX(${currentX + delta}px)`;
}
function showReveal(c,tier){
  $("revealImg").src=c.img;
  $("revealCard").style.setProperty("--glow",tier>=5?"#9d73ffbb":tier>=4?"#6c78ffff":tier>=3?"#ffbf65aa":"#65caff66");
  $("revealCard").classList.add("show");
  $("rarity").textContent=c.rarity;
  $("resultName").textContent=c.name;
  $("odds").textContent="1 / "+c.odds;
  $("reelBanner").textContent=c.rarity.toUpperCase();
}

function shouldUseCutscene(tier){
  return tier>=3; // Legendary and above
}

function playRareCutscene(c,tier){
  return new Promise(resolve=>{
    if(!shouldUseCutscene(tier)){resolve();return;}

    const scene=$("rareCutscene");
    $("cutsceneLine").textContent=
      tier>=5 ? "AN IMPOSSIBLE PRESENCE HAS APPEARED" :
      tier>=4 ? "THE SKY HAS CHANGED" :
      "A RARE PRESENCE HAS BEEN FELT";
    $("cutsceneName").textContent=c.name;
    $("cutsceneFlavor").textContent=c.flavor||"Something extraordinary has been summoned.";
    scene.classList.add("show");

    let finished=false;
    const finish=()=>{
      if(finished)return;
      finished=true;
      scene.classList.remove("show");
      $("cutsceneSkip").onclick=null;
      resolve();
    };

    $("cutsceneSkip").onclick=finish;
    setTimeout(finish,tier>=5?3400:tier>=4?2700:2100);
  });
}

async function roll(){
  if(rolling)return;
  rolling=true;
  $("rollBtn").disabled=true;
  $("autoBtn").disabled=true;
  $("revealCard").classList.remove("show");

  const result=weightedPick();
  const tier=rarityTier(result.rarity);
  const targetIndex=buildReel(result);

  $("rarity").textContent="Rolling...";
  $("resultName").textContent="???";
  $("odds").textContent="The reel is slowing...";
  $("reelBanner").textContent="ROLLING...";
  $("status").textContent=tier>=4
    ?"The air changes... something is watching."
    :"The forest's energy responds to your fate...";

  await new Promise(resolve=>requestAnimationFrame(resolve));

  const item=reelTrack.children[targetIndex];
  const reelBox=$("reel").getBoundingClientRect();
  const itemCenter=item.offsetLeft+item.offsetWidth/2;
  const finalX=reelBox.width/2-itemCenter;
  const duration=[900,1100,1350,1750,2250,3400][tier];

  reelTrack.style.transition=`transform ${duration}ms cubic-bezier(.08,.70,.16,1)`;
  reelTrack.style.transform=`translateX(${finalX}px)`;

  await new Promise(r=>setTimeout(r,duration+50));

  [...reelTrack.children].forEach(x=>x.classList.remove("rollTarget"));
  item.classList.add("rollTarget");

  const pause=[180,230,330,540,900,1450][tier];
  $("reelBanner").textContent=tier>=4?"...":"ONE MORE...";
  await new Promise(r=>setTimeout(r,pause));

  // Legendary, Mythic, and Eldritch discoveries get their own story beat.
  await playRareCutscene(result,tier);

  $("flash").classList.add("on");
  showReveal(result,tier);

  // Every summon becomes its own inventory entry.
  addToInventory(result);

  rolls++;
  coins+=5;

  if(rolls%10===0){
    gems++;
    say("Milestone reached: +1 gem");
  }

  if(!owned.has(result.name)){
    owned.add(result.name);
    coins+=20;
    say("New discovery: "+result.name+"  +20 coins");
  }

  if(result.rarity==="Epic"||tier>=2)epics++;

  if(result.rarity==="Eldritch"){
    gems+=25;
    say("ELDRITCH DISCOVERY  +25 gems");
  }

  recent=[result.name,...recent.filter(n=>n!==result.name)].slice(0,3);
  update();

  $("flash").classList.remove("on");
  $("reelBanner").textContent="RESULT";
  $("status").textContent=
    tier>=5
      ?"The forest falls silent. Something ancient has noticed you."
      :tier>=3
        ?"The discovery has been etched into the Codex."
        :"Your discovery has been recorded in the Codex.";

  rolling=false;
  $("rollBtn").disabled=false;
  $("autoBtn").disabled=false;

  if(auto)setTimeout(roll,500);
}
