        if(!["collectionScreen","inventoryScreen","battleScreen"].includes(el.id))el.style.display="none";
      });
      renderCollectionScreen();
      renderEquippedTeam();
    }
  });
});

buildReel();update();renderInventory();renderCollectionScreen();renderEquippedTeam();
</script>
</body>
</html>
